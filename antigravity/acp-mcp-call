#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${T3_ACP_MCP_NODE:-}" ]]; then
  echo "acp-mcp-call: T3_ACP_MCP_NODE is not set (run inside a T3 Code Antigravity ACP session)" >&2
  exit 1
fi

args=()
if [[ -n "${T3_ACP_MCP_ENTRYPOINT:-}" ]]; then
  args+=("$T3_ACP_MCP_ENTRYPOINT")
fi
args+=(acp-mcp-call "$@")

exec env ELECTRON_RUN_AS_NODE=1 "$T3_ACP_MCP_NODE" "${args[@]}"
