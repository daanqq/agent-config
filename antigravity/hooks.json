{
  "disabled-tools": {
    "PreToolUse": [
      {
        "matcher": "^schedule$",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '{\"decision\":\"deny\",\"reason\":\"Built-in schedule tool is disabled by user policy.\"}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^ask_question$",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '{\"decision\":\"deny\",\"reason\":\"ask_question is disabled by user policy. Ask the user directly in plain text instead.\"}'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "shell-guards": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/libexec/agent-config/grep-literal-glob\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
