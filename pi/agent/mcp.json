{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--chromeArg=--remote-debugging-port=0",
        "--chromeArg=--window-size=1920,1080"
      ],
      "directTools": false
    },
    "chrome-devtools-shared": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9223"
      ],
      "directTools": false
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientName": "Claude Code"
      }
    }
  }
}
