{
  "lastChangelogVersion": "1.5.2",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.2-sol",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@plannotator/pi-extension"
  ],
  "skills": [
    "-skills/plannotator/SKILL.md"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": false,
  "compaction": {
    "enabled": true
  },
  "enabledModels": [
    "openai-codex/gpt-6.2-sol",
    "openai-codex/gpt-6.2-astra",
    "openai-codex/gpt-5.6-luna",
    "openrouter/xiaomi/mimo-v2.6-pro"
  ],
  "externalEditor": "code --wait",
  "transport": "sse",
  "collapseChangelog": true,
  "treeFilterMode": "no-tools",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 5,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "httpIdleTimeoutMs": 120000,
  "retry": {
    "maxRetries": 9,
    "maxAgentDelayMs": 60000
  },
  "defaultProjectTrust": "always",
  "outputPad": 0,
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "showCacheMissNotices": true,
  "fullscreenExitOutput": "resume-hint",
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-sol": "medium",
    "openai-codex/gpt-5.6-luna": "high",
    "openrouter/z-ai/glm-5.3-flash": "high"
  },
  "markdown": {
    "mermaid": "final"
  },
  "fullscreenCopyOnSelect": true,
  "extensions": [
    "-extensions/apply-patch/index.ts",
    "-extensions/cliproxy-quota/index.ts",
    "-extensions/video-analysis/index.ts",
    "-extensions/web-access.ts",
    "-extensions/00-ui-header.ts",
    "-extensions/00-ui-00-transition.ts",
    "-extensions/00-ui-editor.ts",
    "-extensions/00-ui-footer.ts",
    "-extensions/agent-pulse.ts",
    "-extensions/auto-session-name/index.ts",
    "-extensions/balance.ts",
    "-extensions/codex-ws-diagnostics/index.ts",
    "-extensions/context-limit-warning.ts",
    "-extensions/pi-paste.ts",
    "-extensions/token-efficiency.ts",
    "-extensions/subagents/index.ts",
    "-extensions/skill-dollar.ts"
  ],
  "cacheWarming": "idle",
  "fullscreenWheelScrollLines": "auto"
}
