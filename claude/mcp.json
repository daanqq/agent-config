{
  "mcpServers": {
    "fff": {
      "type": "stdio",
      "command": "{{HOME}}/.local/bin/fff-mcp",
      "args": [],
      "env": {},
      "alwaysLoad": true
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--headless",
        "--isolated",
        "--chromeArg=--window-size=1920,1080",
        "--chromeArg=--remote-debugging-port=0"
      ],
      "env": {}
    },
    "chrome-devtools-shared": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--browserUrl",
        "http://127.0.0.1:9223"
      ],
      "env": {}
    }
  }
}
