{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "cat \"$HOME\"/.claude/secrets/cliproxy-api-key",
  "env": {
    "ANTHROPIC_BASE_URL": "https://new.tail354056.ts.net",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "ScheduleWakeup",
      "Monitor",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "SendFeedback",
      "NotebookEdit",
      "PushNotification",
      "EndConversation",
      "RemoteTrigger",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "artifact-components": "off",
    "batch": "off",
    "claude-in-chrome": "off",
    "debug": "off",
    "design-sync": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "run": "off",
    "run-skill-generator": "off",
    "setup-claude": "off",
    "update-config": "off",
    "dataviz": "off",
    "simplify": "off",
    "loop": "off",
    "init": "user-invocable-only",
    "team-onboarding": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableArtifact": true,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "session-report@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 289000
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:alabaster",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": false,
  "fileCheckpointingEnabled": false,
  "spinnerTipsEnabled": false
}
