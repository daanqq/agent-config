{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "cat \"$HOME\"/.claude/secrets/cliproxy-api-key",
  "cleanupPeriodDays": 90,
  "env": {
    "ANTHROPIC_BASE_URL": "https://new.tail354056.ts.net",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "no_proxy": "localhost,127.0.0.1,.ts.net",
    "NO_PROXY": "localhost,127.0.0.1,.ts.net"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "ScheduleWakeup",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "SendFeedback",
      "NotebookEdit",
      "PushNotification",
      "EndConversation",
      "RemoteTrigger",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "artifact-components": "off",
    "batch": "off",
    "claude-in-chrome": "off",
    "debug": "off",
    "design-sync": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "run": "off",
    "run-skill-generator": "off",
    "setup-claude": "off",
    "update-config": "off",
    "dataviz": "off",
    "simplify": "off",
    "loop": "off",
    "claude-api": "off",
    "coding-discipline": "off",
    "a11y-debugging": "user-invocable-only",
    "code-simplification": "user-invocable-only",
    "cookie-debugging": "user-invocable-only",
    "debug-optimize-lcp": "user-invocable-only",
    "grilling": "user-invocable-only",
    "memory-leak-debugging": "user-invocable-only",
    "optimize-images": "user-invocable-only",
    "session-screenshot": "user-invocable-only",
    "show-me-your-work": "user-invocable-only",
    "tdd": "user-invocable-only",
    "trade-offs": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/libexec/agent-config/grep-literal-glob\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/libexec/agent-config/reply-language\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableArtifact": true,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:alabaster",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "fileCheckpointingEnabled": false
}
